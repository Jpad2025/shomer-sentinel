#!/usr/bin/env python3
"""
Ejecuta un escaneo forzado del monitor: un ciclo completo para actualizar status y latency_ms.
"""
import sys
import os

sys.path.insert(0, "/opt/network_monitor/app/scripts")
os.chdir("/opt/network_monitor/app/scripts")

import monitor

def main():
    devices = monitor.get_active_devices()
    print(f"Escaneo forzado: {len(devices)} dispositivos activos")
    for device in devices:
        try:
            monitor.check_device(dict(device))  # Convertir Row a dict si hace falta
        except Exception as e:
            print(f"  Error {device.get('name', device.get('ip_address', '?'))}: {e}")
    monitor._failsafe_check_and_act()
    print("Escaneo completado. latency_ms actualizado en devices.")

if __name__ == "__main__":
    main()
