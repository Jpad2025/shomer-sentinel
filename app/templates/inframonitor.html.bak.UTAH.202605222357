{% extends "base.html" %}
{% set active_module = "inframonitor" %}
{% block page_title %}Inframonitor — Dispositivos de Red{% endblock %}

{% block extra_styles %}
.page-header { display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); background:var(--sidebar); padding:16px 24px; flex-wrap:wrap; gap:12px; }
.page-header-left h1 { font-size:18px; font-weight:700; color:var(--text); }
.page-header-left p  { font-size:12px; color:var(--muted); margin-top:2px; }
.btn-hdr { display:flex; align-items:center; gap:7px; border:none; border-radius:6px; padding:8px 16px; font-size:13px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; transition:all 0.2s; }
.btn-hdr svg { width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:2; }

.stat-bar { display:flex; gap:10px; flex-wrap:wrap; }
.sp { display:flex; align-items:center; gap:8px; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:10px 14px; }
.sp svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2; }
.sp-v { font-size:18px; font-weight:700; line-height:1; }
.sp-l { font-size:10px; color:var(--muted); margin-top:2px; text-transform:uppercase; letter-spacing:0.5px; }

/* Add form */
.add-form-card { background:var(--card); border:1px solid rgba(6,182,212,0.4); border-radius:8px; padding:16px; }
.add-form-title { font-size:13px; font-weight:600; color:var(--cyan); margin-bottom:12px; display:flex; align-items:center; gap:8px; }
.form-row { display:grid; grid-template-columns:1fr 1fr 130px 1fr 90px; gap:10px; align-items:end; }
.form-field { display:flex; flex-direction:column; gap:4px; }
.form-field label { font-size:11px; color:var(--muted); font-weight:600; text-transform:uppercase; letter-spacing:0.4px; }
.form-field input, .form-field select {
  background:var(--bg); border:1px solid var(--border); border-radius:6px;
  padding:7px 10px; color:var(--text); font-size:12px; font-family:'Inter',sans-serif; outline:none;
}
.form-field input:focus, .form-field select:focus { border-color:var(--cyan); }
.btn-add { background:var(--cyan); color:#000; border:none; border-radius:6px; padding:8px 18px; font-size:13px; font-weight:700; cursor:pointer; font-family:'Inter',sans-serif; white-space:nowrap; height:34px; }
.btn-cancel-form { background:transparent; color:var(--muted); border:1px solid var(--border); border-radius:6px; padding:8px 14px; font-size:12px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; height:34px; }

/* Table */
.table-wrap { background:var(--card); border:1px solid var(--border); border-radius:8px; overflow:hidden; }
.table-head-bar { display:flex; align-items:center; justify-content:space-between; padding:10px 16px; border-bottom:1px solid var(--border); background:var(--sidebar); }
.table-head-bar h3 { font-size:13px; font-weight:600; color:var(--text); }
.table-scroll { overflow-x:auto; max-height:calc(100vh - 320px); overflow-y:auto; }
table { width:100%; border-collapse:collapse; }
thead { background:var(--sidebar); position:sticky; top:0; z-index:1; }
th { padding:7px 12px; text-align:left; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; color:var(--muted); white-space:nowrap; border-bottom:1px solid var(--border); }
td { padding:8px 12px; font-size:12px; color:var(--text); border-bottom:1px solid var(--border); vertical-align:middle; }
tr:hover td { background:rgba(30,42,58,0.4); }
tr:last-child td { border-bottom:none; }

/* Status */
.status-dot { display:inline-block; width:9px; height:9px; border-radius:50%; flex-shrink:0; vertical-align:middle; margin-right:5px; }
.dot-online  { background:var(--online);  box-shadow:0 0 5px rgba(34,197,94,0.6); }
.dot-offline { background:var(--offline); box-shadow:0 0 5px rgba(220,38,38,0.5); }
.dot-unknown { background:var(--muted); animation:pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

/* Badges */
.type-badge  { background:rgba(6,182,212,0.1); border:1px solid rgba(6,182,212,0.3); color:var(--cyan); border-radius:4px; padding:2px 7px; font-size:10px; font-weight:600; text-transform:uppercase; }
.status-badge-on  { background:rgba(34,197,94,0.15);  color:var(--online);  border-radius:4px; padding:2px 8px; font-size:10px; font-weight:600; }
.status-badge-off { background:rgba(220,38,38,0.15);  color:var(--offline); border-radius:4px; padding:2px 8px; font-size:10px; font-weight:600; }
.status-badge-unk { background:rgba(148,163,184,0.12); color:var(--muted);  border-radius:4px; padding:2px 8px; font-size:10px; font-weight:600; }
.uptime-hi  { background:rgba(34,197,94,0.12);  color:var(--online);  border-radius:4px; padding:1px 6px; font-size:10px; font-weight:700; }
.uptime-mid { background:rgba(245,158,11,0.12); color:var(--warning); border-radius:4px; padding:1px 6px; font-size:10px; font-weight:700; }
.uptime-lo  { background:rgba(220,38,38,0.12);  color:var(--offline); border-radius:4px; padding:1px 6px; font-size:10px; font-weight:700; }
.tcp-ok  { color:var(--online);  font-size:11px; font-weight:600; }
.tcp-fail{ color:var(--offline); font-size:11px; font-weight:600; }

/* Action buttons */
.btn-ping    { background:rgba(6,182,212,0.12); color:var(--cyan);    border:1px solid rgba(6,182,212,0.3);  border-radius:5px; padding:3px 10px; font-size:11px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; }
.btn-ping:hover    { background:rgba(6,182,212,0.25); }
.btn-del-row { background:rgba(220,38,38,0.1);  color:var(--offline); border:1px solid rgba(220,38,38,0.3);  border-radius:5px; padding:3px 10px; font-size:11px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; }
.btn-del-row:hover { background:rgba(220,38,38,0.22); }
{% endblock %}

{% block content %}
<div class="page-header">
  <div class="page-header-left">
    <h1>Inframonitor</h1>
    <p>Monitoreo ICMP + TCP — switches, servidores, cámaras y cualquier equipo de red</p>
  </div>
  <div style="display:flex;gap:10px;align-items:center;">
    <button class="btn-hdr" onclick="toggleAddForm()" id="btn-toggle-add"
      style="background:var(--cyan);color:#000;">
      <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Agregar Equipo
    </button>
    <button class="btn-hdr" onclick="openNOC()"
      style="background:rgba(245,197,24,0.12);border:1px solid rgba(245,197,24,0.4);color:var(--gold);">
      <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><polyline points="8 21 12 17 16 21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      Ver NOC
    </button>
    <button class="btn-hdr" onclick="loadDevices()"
      style="background:transparent;border:1px solid var(--border);color:var(--muted);">
      <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
      Actualizar
    </button>
  </div>
</div>

<div style="padding:20px;display:flex;flex-direction:column;gap:14px;">

  <!-- Stats -->
  <div class="stat-bar">
    <div class="sp" style="border-color:rgba(34,197,94,0.3);">
      <svg viewBox="0 0 24 24" style="color:var(--online)"><polyline points="20 6 9 17 4 12"/></svg>
      <div><div class="sp-v" id="stat-online" style="color:var(--online);">0</div><div class="sp-l">En línea</div></div>
    </div>
    <div class="sp" style="border-color:rgba(220,38,38,0.3);">
      <svg viewBox="0 0 24 24" style="color:var(--offline)"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      <div><div class="sp-v" id="stat-offline" style="color:var(--offline);">0</div><div class="sp-l">Fuera de línea</div></div>
    </div>
    <div class="sp" style="border-color:rgba(148,163,184,0.2);">
      <svg viewBox="0 0 24 24" style="color:var(--muted)"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
      <div><div class="sp-v" id="stat-total" style="color:var(--muted);">0</div><div class="sp-l">Total</div></div>
    </div>
    <div style="margin-left:auto;font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;">
      <span class="status-dot dot-unknown"></span>
      <span id="last-poll">Actualizando...</span>
    </div>
  </div>

  <!-- Add form (hidden by default) -->
  <div id="add-form-wrap" style="display:none;">
    <div class="add-form-card">
      <div class="add-form-title">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Agregar nuevo equipo al monitoreo
      </div>
      <div class="form-row">
        <div class="form-field">
          <label>Dirección IP *</label>
          <input type="text" id="new-ip" placeholder="192.168.1.10" autocomplete="off">
        </div>
        <div class="form-field">
          <label>Nombre *</label>
          <input type="text" id="new-name" placeholder="Switch Piso 1" autocomplete="off">
        </div>
        <div class="form-field">
          <label>Tipo</label>
          <select id="new-type">
            <option value="generic">Genérico</option>
            <option value="ap">AP WiFi</option>
            <option value="router">Router</option>
            <option value="switch">Switch</option>
            <option value="server">Servidor</option>
            <option value="nas">NAS / Storage</option>
            <option value="camera">Cámara IP</option>
            <option value="printer">Impresora</option>
            <option value="pos">POS / Caja</option>
            <option value="reader">Lectora</option>
            <option value="controller">Controladora</option>
            <option value="pc">PC / Laptop</option>
            <option value="phone">Teléfono IP</option>
            <option value="ups">UPS</option>
          </select>
        </div>
        <div class="form-field">
          <label>Ubicación</label>
          <input type="text" id="new-location" placeholder="Sala de servidores" autocomplete="off">
        </div>
        <div class="form-field">
          <label>Puerto TCP</label>
          <input type="number" id="new-tcpport" placeholder="443" min="1" max="65535" autocomplete="off"
            title="Opcional — verifica si el servicio responde (ej: 443 servidor, 554 cámara, 80 NAS)">
        </div>
      </div>
      <div style="margin-top:8px;font-size:11px;color:var(--muted);">
        💡 <strong>Puerto TCP (opcional):</strong> además del ping, verifica si el servicio está activo.
        Ej: <code>443</code> servidor · <code>554</code> cámara RTSP · <code>9100</code> impresora · <code>5000</code> NAS Synology
      </div>
      <div style="display:flex;gap:8px;margin-top:12px;">
        <button class="btn-add" onclick="addDevice()">
          <svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:2;display:inline;vertical-align:middle;margin-right:4px;"><polyline points="20 6 9 17 4 12"/></svg>
          Guardar equipo
        </button>
        <button class="btn-cancel-form" onclick="toggleAddForm()">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Device table -->
  <div class="table-wrap">
    <div class="table-head-bar">
      <h3 style="display:flex;align-items:center;gap:8px;">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:var(--cyan);stroke-width:2;"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><path d="M4.93 4.93l14.14 14.14"/></svg>
        Equipos monitoreados
      </h3>
      <span style="font-size:11px;color:var(--muted);">Ping cada 30 segundos · TCP si configurado</span>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Estado</th>
            <th>Nombre</th>
            <th>IP / MAC</th>
            <th>Tipo</th>
            <th>Ubicación</th>
            <th>Latencia / TCP</th>
            <th>Uptime 24h</th>
            <th style="text-align:right;">Acciones</th>
          </tr>
        </thead>
        <tbody id="devices-tbody">
          <tr><td colspan="8" style="text-align:center;color:var(--muted);padding:24px;">Cargando equipos...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}

{% block extra_scripts %}
<script>
  let _devices = [];
  let _statusInterval = null;

  function ago(isoStr) {
    if (!isoStr) return '—';
    const diff = Math.floor((Date.now() - new Date(isoStr + 'Z').getTime()) / 1000);
    if (diff < 5)    return 'ahora';
    if (diff < 60)   return diff + 's';
    if (diff < 3600) return Math.floor(diff/60) + 'm';
    return Math.floor(diff/3600) + 'h ' + Math.floor((diff%3600)/60) + 'm';
  }

  function uptimeBadge(pct) {
    if (pct == null) return '<span style="color:var(--muted);font-size:11px;">—</span>';
    const cls = pct >= 95 ? 'uptime-hi' : pct >= 80 ? 'uptime-mid' : 'uptime-lo';
    return `<span class="${cls}">${pct}%</span>`;
  }

  function tcpCell(tcp_ok, tcp_port) {
    if (tcp_port == null) return '<span style="color:var(--muted);font-size:11px;">—</span>';
    if (tcp_ok === 1) return `<span class="tcp-ok">✓ :${tcp_port}</span>`;
    if (tcp_ok === 0) return `<span class="tcp-fail">✗ :${tcp_port}</span>`;
    return `<span style="color:var(--muted);font-size:11px;">:${tcp_port}</span>`;
  }

  const TYPE_LABELS = {
    generic:'Genérico', ap:'AP WiFi', router:'Router', switch:'Switch',
    server:'Servidor', nas:'NAS', camera:'Cámara', printer:'Impresora',
    pos:'POS', reader:'Lectora', controller:'Controladora',
    pc:'PC', phone:'Teléfono IP', ups:'UPS',
  };
  const _ico = (p) => `<svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:none;stroke:var(--cyan);stroke-width:2;vertical-align:middle;margin-right:4px;">${p}</svg>`;
  const TYPE_ICONS = {
    generic:    _ico('<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/>'),
    ap:         _ico('<path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>'),
    router:     _ico('<rect x="2" y="9" width="20" height="9" rx="2"/><path d="M8 9V5l4-2 4 2v4"/><line x1="8" y1="14" x2="8.01" y2="14"/><line x1="12" y1="14" x2="12.01" y2="14"/>'),
    switch:     _ico('<rect x="2" y="6" width="20" height="12" rx="2"/><line x1="7" y1="10" x2="7" y2="14"/><line x1="12" y1="10" x2="12" y2="14"/><line x1="17" y1="10" x2="17" y2="14"/>'),
    server:     _ico('<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>'),
    nas:        _ico('<line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>'),
    camera:     _ico('<path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/>'),
    printer:    _ico('<polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>'),
    pos:        _ico('<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>'),
    reader:     _ico('<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/><line x1="15" y1="9" x2="15" y2="21"/>'),
    controller: _ico('<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>'),
    pc:         _ico('<rect x="2" y="3" width="20" height="14" rx="2"/><polyline points="8 21 12 17 16 21"/><line x1="12" y1="17" x2="12" y2="21"/>'),
    phone:      _ico('<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 8.81 19.79 19.79 0 0 1 1.61 2.2 2 2 0 0 1 3.6.01h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 7.91a16 16 0 0 0 6.16 6.16l.95-.95a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>'),
    ups:        _ico('<path d="M23 6l-9.5 9.5-5-5L1 18"/><polyline points="17 6 23 6 23 12"/>'),
  };

  function renderTable(devices) {
    const tbody = document.getElementById('devices-tbody');
    if (!devices.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:30px;">Sin equipos registrados. Usa <strong style="color:var(--cyan)">Agregar Equipo</strong> para comenzar.</td></tr>';
      return;
    }
    tbody.innerHTML = devices.map(dev => {
      const status = dev.status || 'unknown';
      let dotCls, badgeHtml;
      if (status === 'online') {
        dotCls = 'dot-online';
        const dur = dev.state_duration ? `<br><span style="font-size:10px;color:var(--muted);">hace ${dev.state_duration}</span>` : '';
        badgeHtml = `<span class="status-badge-on">● En línea</span>${dur}`;
      } else if (status === 'offline') {
        dotCls = 'dot-offline';
        const dur = dev.state_duration ? `<br><span style="font-size:10px;color:var(--offline);opacity:0.7;">caído ${dev.state_duration}</span>` : '';
        badgeHtml = `<span class="status-badge-off">✕ Sin respuesta</span>${dur}`;
      } else {
        dotCls = 'dot-unknown';
        badgeHtml = '<span class="status-badge-unk">○ Verificando</span>';
      }
      const latStr = dev.latency_ms != null ? dev.latency_ms.toFixed(1) + ' ms' : '—';
      const macHtml = dev.mac
        ? `<br><span style="font-size:10px;color:var(--muted);font-family:monospace;">${dev.mac}</span>`
        : '';

      return `<tr>
        <td>
          <span class="status-dot ${dotCls}" id="dot-${dev.ip}"></span>
          <span id="badge-${dev.ip}">${badgeHtml}</span>
        </td>
        <td style="font-weight:600;">${TYPE_ICONS[dev.device_type] || TYPE_ICONS.generic}${dev.name}</td>
        <td>
          <span style="font-family:monospace;color:var(--cyan);">${dev.ip}</span>${macHtml}
        </td>
        <td><span class="type-badge">${TYPE_LABELS[dev.device_type] || dev.device_type}</span></td>
        <td style="color:var(--muted);">${dev.location || '—'}</td>
        <td id="lat-${dev.ip}">
          <span style="font-family:monospace;">${latStr}</span>
          <br><span id="tcp-${dev.ip}">${tcpCell(dev.tcp_ok, dev.tcp_port)}</span>
        </td>
        <td id="uptime-${dev.ip}">${uptimeBadge(dev.uptime_24h)}</td>
        <td style="text-align:right;white-space:nowrap;">
          <button class="btn-ping" onclick="pingDevice('${dev.ip}')" title="Ping manual">
            <svg viewBox="0 0 24 24" style="width:11px;height:11px;fill:none;stroke:currentColor;stroke-width:2;vertical-align:middle;margin-right:3px;"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>Ping
          </button>
          &nbsp;
          <button class="btn-del-row" onclick="confirmAction('¿Eliminar ${dev.name} (${dev.ip}) del monitoreo?', ()=>deleteDevice(${dev.id}))">
            <svg viewBox="0 0 24 24" style="width:11px;height:11px;fill:none;stroke:currentColor;stroke-width:2;vertical-align:middle;margin-right:3px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>Eliminar
          </button>
        </td>
      </tr>`;
    }).join('');
  }

  function loadDevices() {
    shomerFetch('/infra/devices')
      .then(r => r.json())
      .then(d => {
        _devices = Array.isArray(d.devices) ? d.devices : [];
        renderTable(_devices);
        updateStats(_devices);
        document.getElementById('last-poll').textContent = 'Última actualización: ' + new Date().toLocaleTimeString('es-ES');
      })
      .catch(() => {
        document.getElementById('devices-tbody').innerHTML =
          '<tr><td colspan="8" style="text-align:center;color:var(--offline);padding:20px;">Error al cargar equipos.</td></tr>';
      });
  }

  function pollStatus() {
    shomerFetch('/infra/status')
      .then(r => r.json())
      .then(d => {
        const statuses = Array.isArray(d.devices) ? d.devices : [];
        statuses.forEach(st => {
          // Dot
          const dot = document.getElementById('dot-' + st.ip);
          if (dot) dot.className = 'status-dot ' + (st.status === 'online' ? 'dot-online' : st.status === 'offline' ? 'dot-offline' : 'dot-unknown');

          // Badge + duration
          const badge = document.getElementById('badge-' + st.ip);
          if (badge) {
            if (st.status === 'online') {
              const dur = st.state_duration ? `<br><span style="font-size:10px;color:var(--muted);">hace ${st.state_duration}</span>` : '';
              badge.innerHTML = `<span class="status-badge-on">● En línea</span>${dur}`;
            } else if (st.status === 'offline') {
              const dur = st.state_duration ? `<br><span style="font-size:10px;color:var(--offline);opacity:0.7;">caído ${st.state_duration}</span>` : '';
              badge.innerHTML = `<span class="status-badge-off">✕ Sin respuesta</span>${dur}`;
            }
          }

          // Latency
          const lat = document.getElementById('lat-' + st.ip);
          if (lat) {
            const latStr = st.latency_ms != null ? st.latency_ms.toFixed(1) + ' ms' : '—';
            const tcpEl = document.getElementById('tcp-' + st.ip);
            lat.querySelector('span').textContent = latStr;
            if (tcpEl) tcpEl.innerHTML = tcpCell(st.tcp_ok, st.tcp_port);
          }

          // Uptime
          const up = document.getElementById('uptime-' + st.ip);
          if (up) up.innerHTML = uptimeBadge(st.uptime_24h);
        });
        updateStats(statuses);
        document.getElementById('last-poll').textContent = 'Último ping: ' + new Date().toLocaleTimeString('es-ES');
      })
      .catch(() => {});
  }

  function updateStats(devices) {
    const list = devices || _devices;
    let online = 0, offline = 0;
    list.forEach(d => {
      if (d.status === 'online') online++;
      else if (d.status === 'offline') offline++;
    });
    document.getElementById('stat-online').textContent  = online;
    document.getElementById('stat-offline').textContent = offline;
    document.getElementById('stat-total').textContent   = list.length;
  }

  function toggleAddForm() {
    const wrap = document.getElementById('add-form-wrap');
    const visible = wrap.style.display !== 'none';
    wrap.style.display = visible ? 'none' : 'block';
    document.getElementById('btn-toggle-add').style.background = visible ? 'var(--cyan)' : 'rgba(6,182,212,0.2)';
    if (!visible) document.getElementById('new-ip').focus();
  }

  function addDevice() {
    const ip       = document.getElementById('new-ip').value.trim();
    const name     = document.getElementById('new-name').value.trim();
    const type     = document.getElementById('new-type').value;
    const location = document.getElementById('new-location').value.trim();
    const tcpRaw   = document.getElementById('new-tcpport').value.trim();
    const tcp_port = tcpRaw ? parseInt(tcpRaw) : null;

    if (!ip || !name) { showToast('IP y nombre son obligatorios', 'warning'); return; }
    if (tcp_port !== null && (isNaN(tcp_port) || tcp_port < 1 || tcp_port > 65535)) {
      showToast('Puerto TCP inválido (1-65535)', 'warning'); return;
    }

    const btn = document.querySelector('.btn-add');
    setBtnRunning(btn, true, 'Guardando...');

    shomerFetch('/infra/devices', {
      method: 'POST',
      body: JSON.stringify({ ip, name, device_type: type, location, tcp_port })
    })
      .then(r => r.json().then(d => ({ ok: r.ok, d })))
      .then(({ ok, d }) => {
        setBtnRunning(btn, false);
        if (ok && d.success) {
          showToast(d.message || 'Equipo agregado', 'success');
          document.getElementById('new-ip').value = '';
          document.getElementById('new-name').value = '';
          document.getElementById('new-location').value = '';
          document.getElementById('new-type').value = 'generic';
          document.getElementById('new-tcpport').value = '';
          toggleAddForm();
          loadDevices();
        } else {
          showToast(d.detail || d.message || 'Error al guardar', 'error');
        }
      })
      .catch(() => { setBtnRunning(btn, false); showToast('Error de conexión', 'error'); });
  }

  function deleteDevice(id) {
    shomerFetch('/infra/devices/' + id, { method: 'DELETE' })
      .then(r => r.json().then(d => ({ ok: r.ok, d })))
      .then(({ ok, d }) => {
        if (ok && d.success) {
          showToast(d.message || 'Equipo eliminado', 'success');
          loadDevices();
        } else {
          showToast(d.detail || d.message || 'Error al eliminar', 'error');
        }
      })
      .catch(() => showToast('Error de conexión', 'error'));
  }

  function pingDevice(ip) {
    showToast('Enviando ping a ' + ip + '...', 'warning');
    shomerFetch('/infra/ping/' + ip, { method: 'POST' })
      .then(r => r.json())
      .then(d => {
        if (d.status === 'online') {
          showToast('✓ ' + ip + ' responde — ' + (d.latency_ms != null ? d.latency_ms.toFixed(1) + ' ms' : ''), 'success');
        } else {
          showToast('✕ ' + ip + ' no responde', 'error');
        }
        pollStatus();
      })
      .catch(() => showToast('Error al hacer ping', 'error'));
  }

  function openNOC() {
    shomerFetch('/noc/token')
      .then(r => r.json())
      .then(d => {
        const token = d.token || d.noc_token;
        if (token) {
          window.open('/noc?token=' + encodeURIComponent(token), '_blank');
        } else {
          showToast('Token NOC no configurado — activar en /setup', 'error');
        }
      })
      .catch(() => showToast('Error al obtener token NOC', 'error'));
  }

  document.getElementById('new-ip').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('new-name').focus(); });

  loadDevices();
  _statusInterval = setInterval(pollStatus, 30000);
</script>
{% endblock %}
