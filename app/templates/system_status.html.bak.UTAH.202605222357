{% extends "base.html" %}
{% block page_title %}Estado del Sistema{% endblock %}

{% block extra_styles %}
  .ss-main { display:flex; flex-direction:column; gap:12px; padding:20px; overflow-y:auto; flex:1; }

  /* top bar */
  .ss-topbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; }
  .ss-topbar h1 { font-size:14px; font-weight:700; color:var(--text); letter-spacing:.5px; }
  .ss-updated  { font-size:11px; color:var(--muted); }
  .btn-refresh { font-size:12px; font-weight:600; padding:5px 13px; border-radius:6px; border:1px solid var(--teal); background:rgba(13,110,110,.12); color:var(--teal); cursor:pointer; }
  .btn-refresh:hover   { background:rgba(13,110,110,.25); }
  .btn-refresh:disabled{ opacity:.4; cursor:wait; }

  /* section title */
  .ss-t { font-size:10px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; color:var(--muted); display:flex; align-items:center; gap:6px; margin-bottom:7px; }
  .ss-t svg { width:13px; height:13px; flex-shrink:0; }

  /* grids */
  .grid-svc { display:flex; flex-wrap:wrap; gap:8px; }
  .grid-2eq { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .nics-row { display:flex; flex-wrap:wrap; gap:8px; }

  /* service pill */
  .svc-pill { background:var(--card); border:1px solid var(--border); border-radius:7px; padding:8px 12px; display:flex; align-items:center; gap:8px; flex:1; min-width:160px; max-width:260px; }
  .svc-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; transition:background .3s; }
  .svc-dot.active     { background:var(--online);  box-shadow:0 0 5px var(--online); }
  .svc-dot.inactive   { background:var(--offline); }
  .svc-dot.failed     { background:var(--offline); box-shadow:0 0 4px var(--offline); }
  .svc-dot.activating { background:var(--warning); animation:pulse 1s infinite; }
  .svc-dot.unknown    { background:var(--muted); }
  .svc-info { display:flex; flex-direction:column; gap:1px; min-width:0; flex:1; }
  .svc-name { font-size:12px; font-weight:600; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .svc-lbl  { font-size:10px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .svc-badge { font-size:9px; font-weight:700; text-transform:uppercase; padding:2px 6px; border-radius:3px; flex-shrink:0; }
  .svc-badge.active     { background:rgba(34,197,94,.12);  color:var(--online); }
  .svc-badge.inactive   { background:rgba(220,38,38,.12);  color:var(--offline); }
  .svc-badge.failed     { background:rgba(220,38,38,.18);  color:#f87171; }
  .svc-badge.activating { background:rgba(245,158,11,.12); color:var(--warning); }
  .svc-badge.unknown    { background:rgba(148,163,184,.1); color:var(--muted); }

  /* recursos */
  .res-wrap { display:flex; flex-direction:column; gap:8px; }
  .res-row  { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:9px 12px; }
  .res-head { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:4px; }
  .res-label{ font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:var(--muted); }
  .res-val  { font-size:18px; font-weight:700; color:var(--text); }
  .res-val.sm { font-size:14px; }
  .res-sub  { font-size:10px; color:var(--muted); margin-bottom:4px; }
  .bar-track{ height:4px; background:var(--border); border-radius:2px; overflow:hidden; }
  .bar-fill { height:100%; border-radius:2px; transition:width .5s; }
  .bar-fill.ok    { background:var(--online); }
  .bar-fill.warn  { background:var(--warning); }
  .bar-fill.danger{ background:var(--offline); }

  /* gauges semiarco CPU/RAM */
  .gauge-wrap  { flex:1; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:8px 6px 4px; display:flex; flex-direction:column; align-items:center; }
  .gauge-title { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:var(--muted); margin-bottom:2px; }
  .gauge-svg   { width:100%; overflow:visible; }
  .gauge-sub   { font-size:9px; color:var(--muted); margin-top:2px; text-align:center; line-height:1.3; }

  /* donuts disco */
  .disk-donut-row  { display:flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:8px 12px; }
  .disk-donut-svg  { flex-shrink:0; }
  .disk-donut-info { display:flex; flex-direction:column; gap:2px; min-width:0; flex:1; }

  /* NICs — pills horizontales uniformes */
  .nic-card { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:10px 14px; flex:1; min-width:200px; max-width:320px; display:flex; flex-direction:column; gap:6px; }
  .nic-head { display:flex; align-items:center; gap:7px; }
  .nic-dot  { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .nic-dot.up   { background:var(--online); box-shadow:0 0 4px var(--online); }
  .nic-dot.down { background:var(--offline); }
  .nic-name { font-size:12px; font-weight:700; color:var(--text); flex:1; }
  .nic-speed{ font-size:10px; color:var(--muted); }
  .nic-badge{ font-size:9px; font-weight:700; padding:2px 6px; border-radius:3px; text-transform:uppercase; flex-shrink:0; }
  .nic-badge.up   { background:rgba(34,197,94,.12); color:var(--online); }
  .nic-badge.down { background:rgba(220,38,38,.12); color:var(--offline); }
  .nic-ips  { display:flex; flex-direction:column; gap:3px; }
  .nic-ip   { font-size:10px; font-family:monospace; color:var(--cyan); background:rgba(6,182,212,.07); border-radius:3px; padding:2px 6px; display:flex; align-items:center; gap:5px; overflow:hidden; }
  .nic-ip .ip-tag { font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; flex-shrink:0; }
  .nic-ip .ip-addr { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .nic-traffic { display:flex; gap:12px; }
  .nic-tr-item { font-size:9px; color:var(--muted); display:flex; align-items:center; gap:3px; }
  .nic-tr-item span { color:var(--text); font-weight:600; }

  /* discos */
  .disk-card { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:9px 12px; display:flex; flex-direction:column; gap:5px; }
  .disk-head { display:flex; align-items:baseline; justify-content:space-between; gap:6px; }
  .disk-label{ font-size:12px; font-weight:600; color:var(--text); }
  .disk-path { font-size:10px; color:var(--muted); font-family:monospace; }
  .disk-pct  { font-size:18px; font-weight:700; color:var(--text); }
  .disk-detail{ font-size:10px; color:var(--muted); }

  /* conectividad */
  .conn-bar  { display:flex; flex-wrap:wrap; gap:8px; }
  .conn-pill { background:var(--card); border:1px solid var(--border); border-radius:7px; padding:7px 12px; display:flex; align-items:center; gap:8px; }
  .conn-dot  { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .conn-dot.ok   { background:var(--online); box-shadow:0 0 4px var(--online); }
  .conn-dot.fail { background:var(--offline); }
  .conn-dot.na   { background:var(--muted); }
  .conn-label { font-size:11px; font-weight:600; color:var(--text); }
  .conn-sub   { font-size:10px; color:var(--muted); }
  .conn-stat  { font-size:12px; font-weight:700; margin-left:4px; }
  .conn-stat.ok   { color:var(--online); }
  .conn-stat.warn { color:var(--warning); }

  /* log console */
  .log-console { background:var(--card); border:1px solid var(--border); border-radius:8px; display:flex; flex-direction:column; overflow:hidden; }
  .log-toolbar { display:flex; align-items:center; gap:6px; padding:7px 12px; border-bottom:1px solid var(--border); flex-wrap:wrap; }
  .lt-title { font-size:12px; font-weight:700; color:var(--text); flex:1; min-width:80px; }
  .log-svc-tabs { display:flex; gap:3px; flex-wrap:wrap; }
  .log-tab { font-size:10px; font-weight:600; padding:3px 9px; border-radius:4px; border:1px solid var(--border); background:transparent; color:var(--muted); cursor:pointer; }
  .log-tab:hover  { border-color:var(--cyan); color:var(--text); }
  .log-tab.active { background:rgba(6,182,212,.12); border-color:var(--cyan); color:var(--cyan); }
  .log-btn { font-size:10px; font-weight:600; padding:3px 9px; border-radius:4px; border:1px solid var(--border); background:transparent; color:var(--muted); cursor:pointer; }
  .log-btn:hover    { border-color:var(--text); color:var(--text); }
  .log-btn.auto-on  { border-color:var(--online); color:var(--online); }
  .log-lines { font-family:monospace; font-size:11px; line-height:1.55; color:#7dd3fc; background:#050810; padding:8px 12px; overflow-y:auto; height:160px; white-space:pre-wrap; word-break:break-all; }
  .log-err  { color:#f87171; }
  .log-warn { color:#fbbf24; }
  .log-ok   { color:#4ade80; }
  .log-muted{ color:#475569; }
{% endblock %}

{% block content %}
<div class="ss-main">

  <!-- top bar -->
  <div class="ss-topbar">
    <h1>ESTADO DEL SISTEMA</h1>
    <div class="ss-topbar-r">
      <span class="ss-updated" id="last-update">—</span>
      <button class="btn-refresh" id="btn-refresh" onclick="loadAll()">Actualizar</button>
    </div>
  </div>

  <!-- servicios systemd -->
  <div>
    <div class="ss-t">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><polyline points="8 21 12 17 16 21"/></svg>
      Servicios systemd
    </div>
    <div class="grid-svc" id="services-grid">
      {% for i in range(7) %}
      <div class="svc-pill">
        <span class="svc-dot unknown"></span>
        <div class="svc-info"><span class="svc-name">—</span><span class="svc-lbl">cargando…</span></div>
        <span class="svc-badge unknown">…</span>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- recursos + discos (2 columnas equilibradas) -->
  <div class="grid-2eq">

    <!-- recursos -->
    <div>
      <div class="ss-t">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Recursos
      </div>
      <div class="res-wrap">
        <div style="display:flex;gap:8px;" id="gauges-cpu-ram">
          <div class="gauge-wrap"><div class="gauge-title">CPU</div><div style="font-size:11px;color:var(--muted)">cargando…</div></div>
          <div class="gauge-wrap"><div class="gauge-title">RAM</div><div style="font-size:11px;color:var(--muted)">cargando…</div></div>
        </div>
        <div class="res-row">
          <div class="res-head"><span class="res-label">Temperatura CPU</span><span class="res-val sm" id="res-temp">—</span></div>
        </div>
        <div class="res-row">
          <div class="res-head"><span class="res-label">Uptime</span><span class="res-val sm" id="res-uptime">—</span></div>
        </div>
      </div>
    </div>

    <!-- discos -->
    <div>
      <div class="ss-t">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        Almacenamiento
      </div>
      <div id="disks-grid" style="display:flex;flex-direction:column;gap:8px;">
        {% for i in range(3) %}
        <div class="disk-donut-row">
          <div class="disk-donut-info"><div class="disk-label">—</div><div class="disk-detail">cargando…</div></div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- NICs — fila horizontal, todas del mismo alto -->
  <div>
    <div class="ss-t">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="8" width="20" height="8" rx="2"/><line x1="6" y1="12" x2="6.01" y2="12"/><line x1="10" y1="12" x2="10.01" y2="12"/><line x1="12" y1="2" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="22"/></svg>
      Tarjetas de red
    </div>
    <div class="nics-row" id="nics-grid">
      <div class="nic-card"><div class="nic-head"><span class="nic-dot down"></span><span class="nic-name">cargando…</span></div></div>
    </div>
  </div>

  <!-- conectividad -->
  <div>
    <div class="ss-t">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      Conectividad y estados
    </div>
    <div class="conn-bar" id="conn-bar">
      <div class="conn-pill"><span class="conn-dot na"></span><span class="conn-label">cargando…</span></div>
    </div>
  </div>

  <!-- consola de logs -->
  <div class="log-console">
    <div class="log-toolbar">
      <span class="lt-title">Consola de logs</span>
      <div class="log-svc-tabs">
        <button class="log-tab active" data-svc="shomer-guardian" onclick="selectSvc(this)">guardian</button>
        <button class="log-tab" data-svc="shomer-tools"   onclick="selectSvc(this)">tools</button>
        <button class="log-tab" data-svc="shomer-monitor" onclick="selectSvc(this)">monitor</button>
        <button class="log-tab" data-svc="nginx"          onclick="selectSvc(this)">nginx</button>
        <button class="log-tab" data-svc="redis-server"   onclick="selectSvc(this)">redis</button>
        <button class="log-tab" data-svc="suricata"       onclick="selectSvc(this)">suricata</button>
        <button class="log-tab" data-svc="wazuh-manager"  onclick="selectSvc(this)">wazuh</button>
      </div>
      <button class="log-btn" id="btn-auto" onclick="toggleAuto()">Auto OFF</button>
      <button class="log-btn" onclick="clearLogs()">Limpiar</button>
    </div>
    <div class="log-lines" id="log-output">Selecciona un servicio…</div>
  </div>

</div>
{% endblock %}

{% block extra_scripts %}
<script>
var _logSvc    = 'shomer-guardian';
var _autoTimer = null;
var _autoOn    = false;

function barCls(p) { return p >= 90 ? 'danger' : p >= 70 ? 'warn' : 'ok'; }
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function tsNow() {
  return new Date().toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
}

// ── servicios ──
function renderServices(svcs) {
  var g = document.getElementById('services-grid');
  if (!g) return;
  g.innerHTML = svcs.map(function(s) {
    var cls = s.status || 'unknown';
    return '<div class="svc-pill">'
      + '<span class="svc-dot '+cls+'"></span>'
      + '<div class="svc-info"><span class="svc-name">'+esc(s.name)+'</span><span class="svc-lbl">'+esc(s.label)+'</span></div>'
      + '<span class="svc-badge '+cls+'">'+esc(s.status||'?')+'</span>'
      + '</div>';
  }).join('');
}

// ── gauge helpers ──
function gaugeColor(pct) {
  return pct >= 90 ? 'var(--offline)' : pct >= 70 ? 'var(--warning)' : 'var(--online)';
}
function semiGauge(label, pct, sub) {
  var r = 40, c = Math.PI * r; // semiarco ≈ 125.66
  var p   = Math.min(100, Math.max(0, pct));
  var fil = (p / 100) * c;
  var col = gaugeColor(p);
  return '<div class="gauge-wrap">'
    + '<div class="gauge-title">'+esc(label)+'</div>'
    + '<svg class="gauge-svg" viewBox="-50 -46 100 56" xmlns="http://www.w3.org/2000/svg">'
    // fondo del arco
    + '<circle cx="0" cy="0" r="'+r+'" fill="none" stroke="var(--border)" stroke-width="7"'
    +   ' stroke-dasharray="'+c.toFixed(1)+' '+c.toFixed(1)+'" transform="rotate(180)"/>'
    // arco de valor
    + '<circle cx="0" cy="0" r="'+r+'" fill="none" stroke="'+col+'" stroke-width="7"'
    +   ' stroke-linecap="round"'
    +   ' stroke-dasharray="'+fil.toFixed(1)+' '+(c*2).toFixed(1)+'" transform="rotate(180)"/>'
    // valor en el centro
    + '<text x="0" y="4" text-anchor="middle" font-size="15" font-weight="700" fill="var(--text)" font-family="inherit">'+p+'%</text>'
    // etiquetas escala
    + '<text x="-40" y="13" text-anchor="middle" font-size="8" fill="var(--muted)">0</text>'
    + '<text x="40" y="13" text-anchor="middle" font-size="8" fill="var(--muted)">100</text>'
    + '</svg>'
    + (sub ? '<div class="gauge-sub">'+esc(sub)+'</div>' : '')
    + '</div>';
}

// ── recursos ──
function renderResources(r, uptime, temp) {
  var gcr = document.getElementById('gauges-cpu-ram');
  if (gcr) {
    gcr.innerHTML =
      semiGauge('CPU', r.cpu_percent, r.cpu_percent + '%') +
      semiGauge('RAM', r.ram_percent, r.ram_used_gb + ' / ' + r.ram_total_gb + ' GB');
  }
  var tu = document.getElementById('res-uptime');
  if (tu && uptime) tu.textContent = uptime.label;
  var tt = document.getElementById('res-temp');
  if (tt) {
    if (temp) {
      var hot = temp.high && temp.celsius >= temp.high * 0.85;
      tt.textContent = temp.celsius + ' °C';
      tt.style.color = hot ? 'var(--warning)' : '';
    } else {
      tt.textContent = '—';
    }
  }
}

// ── NICs ──
function truncIp(addr, max) {
  return addr.length > max ? addr.slice(0, max) + '…' : addr;
}
function renderNics(nics) {
  var g = document.getElementById('nics-grid');
  if (!g) return;
  if (!nics || !nics.length) {
    g.innerHTML = '<div class="nic-card"><span style="font-size:12px;color:var(--muted)">Sin interfaces detectadas</span></div>';
    return;
  }
  g.innerHTML = nics.map(function(n) {
    var upCls = n.is_up ? 'up' : 'down';
    var ipv4 = null, ipv6 = null;
    (n.ips || []).forEach(function(ip) {
      if (!ipv4 && ip.family === 'IPv4') ipv4 = ip;
      if (!ipv6 && ip.family === 'IPv6') ipv6 = ip;
    });
    var speed = n.speed_mb > 0 ? '<span class="nic-speed">'+n.speed_mb+' Mb/s</span>' : '';
    var ipRows = '<div class="nic-ips">'
      + '<div class="nic-ip"><span class="ip-tag">v4</span><span class="ip-addr">'+(ipv4 ? esc(ipv4.address) : '—')+'</span></div>'
      + '<div class="nic-ip"><span class="ip-tag">v6</span><span class="ip-addr">'+(ipv6 ? esc(truncIp(ipv6.address, 26)) : '—')+'</span></div>'
      + '</div>';
    return '<div class="nic-card">'
      + '<div class="nic-head">'
      + '<span class="nic-dot '+upCls+'"></span>'
      + '<span class="nic-name">'+esc(n.name)+'</span>'
      + speed
      + '<span class="nic-badge '+upCls+'">'+(n.is_up?'UP':'DOWN')+'</span>'
      + '</div>'
      + ipRows
      + '<div class="nic-traffic">'
      + '<div class="nic-tr-item">↑ <span>'+n.mb_sent+' MB</span></div>'
      + '<div class="nic-tr-item">↓ <span>'+n.mb_recv+' MB</span></div>'
      + '</div>'
      + '</div>';
  }).join('');
}

// ── discos (donuts) ──
function renderDisks(disks) {
  var g = document.getElementById('disks-grid');
  if (!g) return;
  var r = 26, circ = 2 * Math.PI * r; // ≈ 163.4
  g.innerHTML = disks.map(function(d) {
    if (d.error) {
      return '<div class="disk-donut-row">'
        + '<div class="disk-donut-info"><div class="disk-label">'+esc(d.label)+'</div>'
        + '<div class="disk-path">'+esc(d.path)+'</div>'
        + '<div class="disk-detail" style="color:var(--offline)">'+esc(d.error)+'</div></div>'
        + '</div>';
    }
    var pct = d.percent;
    var fil = (pct / 100) * circ;
    var col = gaugeColor(pct);
    return '<div class="disk-donut-row">'
      + '<svg class="disk-donut-svg" viewBox="-35 -35 70 70" width="62" height="62">'
      + '<circle cx="0" cy="0" r="'+r+'" fill="none" stroke="var(--border)" stroke-width="7"/>'
      + '<circle cx="0" cy="0" r="'+r+'" fill="none" stroke="'+col+'" stroke-width="7"'
      +   ' stroke-linecap="round"'
      +   ' stroke-dasharray="'+fil.toFixed(1)+' '+(circ-fil).toFixed(1)+'"'
      +   ' transform="rotate(-90)"/>'
      + '<text x="0" y="5" text-anchor="middle" font-size="11" font-weight="700" fill="var(--text)">'+pct+'%</text>'
      + '</svg>'
      + '<div class="disk-donut-info">'
      + '<div class="disk-label">'+esc(d.label)+'</div>'
      + '<div class="disk-path">'+esc(d.path)+'</div>'
      + '<div class="disk-detail">'+esc(d.used_gb)+' / '+esc(d.total_gb)+' GB</div>'
      + '<div class="disk-detail">'+esc(d.free_gb)+' GB libres</div>'
      + '</div>'
      + '</div>';
  }).join('');
}

// ── conectividad ──
function renderConnectivity(fp, ports, hunter) {
  var g = document.getElementById('conn-bar');
  if (!g) return;
  var pills = [];

  // firewall ping
  if (fp && fp.host) {
    var dotCls = fp.reachable ? 'ok' : 'fail';
    var stat   = fp.reachable ? (fp.latency_ms !== null ? fp.latency_ms + ' ms' : 'OK') : 'UNREACHABLE';
    var stCls  = fp.reachable ? 'ok' : 'warn';
    pills.push('<div class="conn-pill">'
      + '<span class="conn-dot '+dotCls+'"></span>'
      + '<div><div class="conn-label">Firewall</div><div class="conn-sub">'+esc(fp.host)+'</div></div>'
      + '<span class="conn-stat '+stCls+'">'+esc(stat)+'</span>'
      + '</div>');
  } else {
    pills.push('<div class="conn-pill"><span class="conn-dot na"></span>'
      + '<div><div class="conn-label">Firewall</div><div class="conn-sub">no configurado</div></div></div>');
  }

  // puertos API (TCP)
  (ports || []).forEach(function(p) {
    pills.push('<div class="conn-pill">'
      + '<span class="conn-dot '+(p.reachable?'ok':'fail')+'"></span>'
      + '<div><div class="conn-label">'+esc(p.name)+'</div><div class="conn-sub">:'+p.port+'</div></div>'
      + '</div>');
  });

  // hunter stats
  if (hunter) {
    var actCls = hunter.active_blocks > 0 ? 'warn' : 'ok';
    pills.push('<div class="conn-pill">'
      + '<span class="conn-dot na" style="background:var(--teal)"></span>'
      + '<div><div class="conn-label">IPs bloqueadas activas</div><div class="conn-sub">Bloqueos 24h: '+hunter.blocks_24h+'</div></div>'
      + '<span class="conn-stat '+actCls+'">'+hunter.active_blocks+'</span>'
      + '</div>');
  }

  g.innerHTML = pills.join('');
}

// ── logs ──
function colorLine(line) {
  var l = line.toLowerCase();
  if (l.includes('error')||l.includes('critical')||l.includes('failed'))
    return '<span class="log-err">'+esc(line)+'</span>';
  if (l.includes('warn'))
    return '<span class="log-warn">'+esc(line)+'</span>';
  if (l.includes('started')||l.includes('activo')||l.includes(' ok')||l.includes('success'))
    return '<span class="log-ok">'+esc(line)+'</span>';
  if (line.startsWith('--'))
    return '<span class="log-muted">'+esc(line)+'</span>';
  return esc(line);
}

function loadLogs(svc) {
  shomerFetch('/api/system-logs?service='+encodeURIComponent(svc)+'&lines=80')
    .then(function(r){ return r.json(); })
    .then(function(d){
      var out = document.getElementById('log-output');
      if (!out) return;
      if (d.error) { out.textContent = 'Error: '+d.error; return; }
      out.innerHTML = (d.lines||[]).map(colorLine).join('\n');
      out.scrollTop = out.scrollHeight;
    })
    .catch(function(e){
      var out = document.getElementById('log-output');
      if (out) out.textContent = 'Error: '+e.message;
    });
}

function selectSvc(btn) {
  document.querySelectorAll('.log-tab').forEach(function(t){ t.classList.remove('active'); });
  btn.classList.add('active');
  _logSvc = btn.getAttribute('data-svc');
  loadLogs(_logSvc);
}

function clearLogs() {
  var out = document.getElementById('log-output');
  if (out) out.innerHTML = '<span class="log-muted">— consola limpiada —</span>';
}

function toggleAuto() {
  _autoOn = !_autoOn;
  var btn = document.getElementById('btn-auto');
  if (_autoOn) {
    btn.textContent = 'Auto ON'; btn.classList.add('auto-on');
    _autoTimer = setInterval(function(){ loadLogs(_logSvc); }, 10000);
  } else {
    btn.textContent = 'Auto OFF'; btn.classList.remove('auto-on');
    clearInterval(_autoTimer); _autoTimer = null;
  }
}

// ── carga principal ──
function loadAll() {
  var btn = document.getElementById('btn-refresh');
  if (btn) btn.disabled = true;
  shomerFetch('/api/system-health')
    .then(function(r){ return r.json(); })
    .then(function(d){
      renderServices(d.services   || []);
      renderResources(d.resources || {}, d.uptime, d.temperature);
      renderNics(d.nics           || []);
      renderDisks(d.disks         || []);
      renderConnectivity(d.firewall_ping, d.api_ports, d.hunter_stats);
      var lu = document.getElementById('last-update');
      if (lu) lu.textContent = 'Actualizado: '+tsNow()+(d.hostname?' — '+d.hostname:'');
    })
    .catch(function(e){ console.error('system-health:', e); })
    .finally(function(){ if (btn) btn.disabled = false; });
  loadLogs(_logSvc);
}

document.addEventListener('DOMContentLoaded', function(){
  loadAll();
  setInterval(function(){
    shomerFetch('/api/system-health')
      .then(function(r){ return r.json(); })
      .then(function(d){
        renderServices(d.services   || []);
        renderResources(d.resources || {}, d.uptime, d.temperature);
        renderNics(d.nics           || []);
        renderDisks(d.disks         || []);
        renderConnectivity(d.firewall_ping, d.api_ports, d.hunter_stats);
        var lu = document.getElementById('last-update');
        if (lu) lu.textContent = 'Actualizado: '+tsNow()+(d.hostname?' — '+d.hostname:'');
      }).catch(function(){});
  }, 30000);
});
</script>
{% endblock %}
